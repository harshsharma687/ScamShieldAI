# Base URL of the ScamShield AI backend API.
# Copy this file to .env.local if your backend runs somewhere else.
VITE_API_URL=http://localhost:5000/api

# PostHog analytics + Session Replay (optional).
# Copy the project API key from your PostHog project settings. Leave it empty
# to ship the app with analytics and session replay completely disabled.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
