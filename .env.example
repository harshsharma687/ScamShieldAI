# ---------------------------------------------------------------------------
# ScamShield AI backend — copy this file to .env and fill in real values.
# Never commit .env to Git.
# ---------------------------------------------------------------------------

# Server (must not be 0: the frontend calls localhost:5000)
PORT=5000
NODE_ENV=development
# Only enable when the API runs behind a trusted reverse proxy (nginx, Render, etc.)
TRUST_PROXY=false

# MySQL (local development)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scam_shield_ai
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Hosted MySQL (Aiven, Railway, TiDB Cloud, PlanetScale, ...).
# Keep your local values above and just change these four lines before deploying:
#   DB_HOST=your-service.aivencloud.com
#   DB_PORT=12345
#   DB_USER=avnadmin
#   DB_PASSWORD=the-password-from-the-provider
# Managed servers require TLS:
DB_SSL=false
# Optional: path to the CA certificate the provider gives you (PEM file).
# With this set, the server certificate is fully verified:
#   DB_SSL_CA_PATH=certs/aiven-ca.pem
DB_SSL_CA_PATH=
# Connection pool size. Keep it small on free tiers (often 5-20 connections).
DB_POOL_MAX=10

# JWT — generate long random values, for example:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# AI provider (any OpenAI-compatible /chat/completions API with vision support).
# The key stays on the server. AI writes explanations/recommendations in the
# language of the submitted content (English, Hindi or Hinglish).
#
# Google Gemini (free tier, vision) — create a key at https://aistudio.google.com/apikey
#   AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-flash-lite-latest
# (Model availability varies per project. List yours with:
#  GET https://generativelanguage.googleapis.com/v1beta/openai/models)
#
# OpenRouter (free vision model):
#   AI_API_URL=https://openrouter.ai/api/v1
#   AI_MODEL=google/gemma-4-31b-it:free
#
# Z.ai / other OpenAI-compatible providers work the same way.
# Leave AI_API_KEY empty to use the clearly-labelled deterministic fallback for
# links/messages. Image scans then use local OCR and are marked unverified; set
# a vision-capable model here for real image analysis.
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
AI_TIMEOUT_MS=45000

# Optional Google Safe Browsing v4 key. When empty, no blacklist claim is made.
SAFE_BROWSING_API_KEY=

# SMTP for password-reset and email-change messages.
# Gmail requires an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ScamShield AI <no-reply@example.com>

# Uploads
# MAX_IMAGE_SIZE_MB is checked before anything is stored or analysed.
MAX_IMAGE_SIZE_MB=10
# UPLOAD_DIR is only used when Cloudinary is NOT configured (local development
# and the automated test suite). With Cloudinary set, nothing is written to the
# server disk.
UPLOAD_DIR=uploads

# Cloudinary image storage (recommended, required in production).
# Create a free account at https://cloudinary.com and copy the three values
# from Dashboard -> Product Environment Credentials.
# Scan images and profile photos are uploaded here, and deleted from here when a
# scan or account is removed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=scamshield
